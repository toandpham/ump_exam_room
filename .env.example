# ============================================================
# Exam System — environment configuration
# Copy to .env and adjust. Do NOT commit .env.
# ============================================================

# --- Runtime ---
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=exam
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=exam_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async SQLAlchemy URL (asyncpg). Must match the values above.
DATABASE_URL=postgresql+asyncpg://exam:change_me_postgres@postgres:5432/exam_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Generate a strong secret, e.g.: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8
BCRYPT_ROUNDS=12

# --- Encryption (at-rest exam payload) ---
PBKDF2_ITERATIONS=600000

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=20

# --- Rate limiting ---
# (Đăng nhập ADMIN không dùng biến này — nó khoá tăng dần theo IP, core/login_guard.)
EXAM_LOGIN_RATE=10/2minutes      # candidate CCCD login attempts per IP

# --- Tài nguyên máy chủ ---
# install.sh tự dò RAM/số nhân rồi ghi các biến này vào .env khi cài. Để trống thì
# dùng mặc định dưới đây (chỉnh cho máy 24GB RAM / 10 nhân, ~500 thí sinh).
# Ràng buộc: UVICORN_WORKERS × 25 < PG_MAX_CONNECTIONS.
#UVICORN_WORKERS=6
#PG_MAX_CONNECTIONS=600
#PG_SHARED_BUFFERS=1GB
#PG_EFFECTIVE_CACHE=3GB

# --- CORS (dev) ---
CORS_ORIGINS=http://localhost,http://exam-server.local

# --- Frontend (Vite, build-time) ---
# Same-origin via Caddy, so relative paths. Override only if needed.
VITE_API_BASE=/api
VITE_WS_BASE=/ws

# --- Khoá máy thi (AD-91) ---
# Chỉ cho làm bài bằng PHẦN MỀM KIOSK. Trình duyệt thường (Firefox/Chrome…) vào
# /thisinh/ sẽ bị từ chối kèm hướng dẫn mở ứng dụng thi.
# Đặt false nếu cần cho thi tạm bằng trình duyệt (rồi: docker compose up -d backend).
# (Safe Exam Browser đã gỡ — hệ thống dùng UMP ExamKiosk riêng.)
KIOSK_ONLY=true
